#!/usr/bin/env bash
set -euo pipefail

PIDFILE="${VERIFY_BUILD_ARENA_PIDFILE:-/tmp/verify-build-arena.pid}"

if [[ ! -f "$PIDFILE" ]]; then
  echo "cleanup: no pidfile; nothing to stop"
  exit 0
fi

pid="$(tr -d '[:space:]' <"$PIDFILE")"
if kill -0 "$pid" 2>/dev/null; then
  kill "$pid"
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "cleanup: pid $pid did not exit after SIGTERM" >&2
    exit 1
  fi
  echo "cleanup: stopped pid=$pid"
else
  echo "cleanup: pid $pid already gone"
fi
rm -f "$PIDFILE"
